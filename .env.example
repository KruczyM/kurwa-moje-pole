# Konfiguracja klienta gry (Vite):
# Adres serwera multiplayer (zostaw puste dla localhost:3001, ustaw w produkcji na wlasny serwer z HTTPS/WSS):
# VITE_SERVER_URL=https://twoj-serwer-multiplayer.pl

# Konfiguracja serwera pokojow (Node.js):
PORT=3001
CORS_ORIGIN=*

# Opcjonalny klucz Gemini API dla osobowosci AI NPC (mozna tez podac bezposrednio w interfejsie gry pod ikona zembatki):
# VITE_GEMINI_API_KEY=

